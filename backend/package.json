{
  "name": "backend",
  "version": "1.0.0",
  "description": "CodingHub Backend API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --test test/api.test.js test/http-foundations.test.js test/circuit-breaker.test.js test/integration-services.test.js",
    "test:jest": "npm run build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "migrate:json": "tsx scripts/migrate-json-to-mongo.ts",
    "seed:development": "tsx scripts/seed-development.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ajv": "^8.17.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "graphql": "^16.11.0",
    "helmet": "^8.3.0",
    "jest": "^30.2.0",
    "mongoose": "^9.11.1",
    "morgan": "^1.12.1",
    "pg": "^8.16.3",
    "soap": "^1.2.0",
    "supertest": "^7.1.4",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "mongodb-memory-server": "^10.2.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
