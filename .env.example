JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
MONGO_INITDB_ROOT_USERNAME=codinghub
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-long-random-password
# Compose builds MONGODB_URI with the mongo service hostname; leave it unset here.
MONGO_PORT=27017
FRONTEND_URL=http://localhost:8080
TRUST_PROXY_HOPS=1
ENABLE_HSTS=false
WEB_PORT=8080
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MS=900000
PROFILE_SYNC_RATE_LIMIT=10
PROFILE_SYNC_RATE_WINDOW_MS=900000
CONTEST_CREATE_RATE_LIMIT=30
CONTEST_CREATE_RATE_WINDOW_MS=3600000
PROFILE_SYNC_TIMEOUT_MS=12000
CODEFORCES_API_URL=https://codeforces.com/api
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql/
